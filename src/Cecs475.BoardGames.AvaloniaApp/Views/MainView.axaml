<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:metadata="using:System.Reflection.Metadata"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Cecs475.BoardGames.AvaloniaApp.MainView"
             xmlns:chess="using:Cecs475.BoardGames.Chess.AvaloniaView"
			 >
	<UserControl.Resources>
		<chess:ChessView x:Key="view"/>
		<chess:PlayerIntToStringConverter x:Key="PlayerIntToStringConverter"/>
		<chess:AdvantageToStringConverter x:Key="AdvantageToStringConverter"/>
	</UserControl.Resources>
	<DockPanel DataContext="{DynamicResource vm}" x:DataType="chess:ChessViewModel">
		<StackPanel DockPanel.Dock="Top" >
			<Button IsEnabled="{Binding CanUndo}"
					Padding="4" Click="Button_Click">Undo last move</Button>
		</StackPanel>
		<StackPanel DockPanel.Dock="Bottom" Height="35" Orientation="Horizontal">
			<Label>Advantage:</Label>
			<Label x:Name="mAdvantageLabel" Content="{Binding BoardAdvantage, Converter={StaticResource AdvantageToStringConverter}}"/>
			<Label Margin="6,0,0,0">Current Player:</Label>
			<Label x:Name="mPlayerLabel" Content="{Binding CurrentPlayer, Converter={StaticResource PlayerIntToStringConverter}}"/>
		</StackPanel>
		<ContentControl x:Name="ViewPlaceholder" Content="{StaticResource view}"/>
	</DockPanel>

</UserControl>
